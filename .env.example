# Dashboard Server Port
PORT=5000

# --- Kalenderdaten: Option A) MCP-Server (empfohlen für Server-Deployment) ---
# Wenn MCP_SERVER_URL gesetzt ist, holt die App die Termine/Aufgaben von dort
# statt über Google OAuth -- kein Browser-Login nötig, funktioniert headless.
# MCP_SERVER_URL=https://dein-mcp-server.example.com/mcp
# MCP_SERVER_TOKEN=
# MCP_EVENTS_TOOL=list-events
# MCP_TASKS_TOOL=
# MCP_TOOL_ARGS={}

# --- Kalenderdaten: Option B) Google OAuth (nur ohne MCP_SERVER_URL aktiv) ---
# Place credentials.json into this directory to activate OAuth authentication.
# Achtung: der OAuth-Flow öffnet beim ersten Start einen Browser -- auf einem
# headless Server (z.B. per Docker) funktioniert das nicht, dort MCP nutzen.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
