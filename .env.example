# Dashboard Server Port
PORT=5000

# ============================================================================
# Eingehender MCP-Server dieses Dashboards (mcp_server.py, zweiter Port)
# ============================================================================
# Eine KI (z.B. ein Mail-Assistent) kann sich hierüber verbinden, um Termine
# sowie Hausaufgaben/Todos anzulegen, zu bearbeiten und zu löschen -- z.B. um
# automatisch einen Termin aus einer wichtigen E-Mail zu erzeugen. Läuft
# separat von der Dashboard-Seite (siehe docker-compose.yml, Service
# "mcp-server"). PFLICHT für den mcp-server-Container, sonst startet er nicht.
#
# Token erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_MCP_AUTH_TOKEN=
DASHBOARD_MCP_PORT=5001

# ============================================================================
# Kalenderdaten für die Dashboard-Anzeige (zwei Optionen)
# ============================================================================

# --- Option A) Ausgehende MCP-Anbindung (empfohlen für Server-Deployment) ---
# Wenn MCP_SERVER_URL gesetzt ist, holt DIESES Dashboard Termine/Aufgaben von
# einem FREMDEN MCP-Server -- kein Browser-Login nötig, funktioniert headless.
# (Nicht zu verwechseln mit DASHBOARD_MCP_AUTH_TOKEN oben -- das ist der
# umgekehrte Weg, bei dem dieses Dashboard selbst der MCP-Server ist.)
# MCP_SERVER_URL=https://dein-mcp-server.example.com/mcp
# MCP_SERVER_TOKEN=
# MCP_EVENTS_TOOL=list-events
# MCP_TASKS_TOOL=
# MCP_TOOL_ARGS={}
# MCP_TOOL_TIMEOUT=20

# --- Option B) Google OAuth (nur ohne MCP_SERVER_URL aktiv) ---
# Place credentials.json into this directory to activate OAuth authentication.
# Achtung: der OAuth-Flow öffnet beim ersten Start einen Browser -- auf einem
# headless Server (z.B. per Docker) funktioniert das nicht, dort MCP nutzen.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
